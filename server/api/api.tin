	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let r = tree.Rewind(d.Db, teamOf(q), who.Device, in.Seq) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, r)
}

fn commit(q anvil.Req, w mut anvil.Out) {
