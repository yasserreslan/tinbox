// RestoreIn is POST .../nodes/{id}/restore: rev 0 brings a node back from the trash as it was.
type RestoreIn struct {
	@json("rev") Rev i64
}

fn restore(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	mut in = RestoreIn{}
	if len(q.Body()) > 0 {
		argo.GetStrict(q.Body(), mut in) catch err {
			badRequest(q, mut w, fault.Message(err))
			return
		}
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let r = tree.Restore(d.Db, teamOf(q), who.Device, idOf(q, "id"), in.Rev) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, r)
}

// RewindIn is POST .../rewind.
type RewindIn struct {
	@json("seq") Seq i64
}

fn rewind(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, true)
	if who == nil {
		return
