fn trash(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let ns = tree.Trash(d.Db, teamOf(q)) catch err {
		sendFault(q, mut w, err)
		return
