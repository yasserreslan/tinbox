type TeamIn struct {
	@json("name") Name str max 100
}

fn createTeam(q anvil.Req, w mut anvil.Out) {
	let who = caller(q, mut w)
	if who == nil {
		return
	}
	mut in = TeamIn{}
	argo.GetStrict(q.Body(), mut in) catch err {
		badRequest(q, mut w, fault.Message(err))
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let t = auth.CreateTeam(d.Db, who, in.Name) catch err {
		sendFault(q, mut w, err)
		return
	}
	w.Status(201)
	sendJSON(mut w, t)
}

// MembersOut is GET /v1/teams/{team}/members.
type MembersOut struct {
	@json("members") Members []auth.MemberOut
}

fn members(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let ms = auth.Members(d.Db, who, teamOf(q)) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, MembersOut{Members: ms})
}

fn removeMember(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, true)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	auth.RemoveMember(d.Db, who, teamOf(q), idOf(q, "user")) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, OkOut{Ok: true})
}

// InviteIn is POST /v1/teams/{team}/invites.
type InviteIn struct {
	@json("email") Email str max 254
	@json("role") Role str max 16
}

fn invite(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, true)
	if who == nil {
		return
	}
	mut in = InviteIn{}
	argo.GetStrict(q.Body(), mut in) catch err {
		badRequest(q, mut w, fault.Message(err))
		return
	}
	mut role str = in.Role
	if len(role) == 0 {
		role = auth.RoleMember
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let code = auth.Invite(d.Db, who, teamOf(q), in.Email, role) catch err {
		sendFault(q, mut w, err)
		return
	}
	w.Status(201)
	sendJSON(mut w, CodeOut{Code: code, ExpiresIn: auth.InviteDays * 86400})
}

// ---- the folder ----

fn head(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let h = tree.Head(d.Db, teamOf(q)) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, h)
}

fn delta(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let cursor = queryInt(q, "cursor", 0)
	mut size = queryInt(q, "limit", DeltaPage)
	if cursor < 0 || size < 1 {
		badRequest(q, mut w, "cursor and limit are numbers")
		return
	}
	size = min(size, DeltaPage)
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let o = tree.Delta(d.Db, teamOf(q), cursor, size) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, o)
}

fn wait(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let cursor = queryInt(q, "cursor", 0)
	if cursor < 0 {
		badRequest(q, mut w, "cursor is a number")
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let team = teamOf(q)
	let start = tide.Now()
	for {
		let h = tree.Head(d.Db, team) catch err {
			sendFault(q, mut w, err)
			return
		}
		if h.Seq != cursor || tide.Since(start) >= WaitFor {
			sendJSON(mut w, h)
			return
		}
		tide.Wait(WaitPoll) catch _ {
			sendJSON(mut w, h)
			return
		}
	}
}

fn snapshot(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let after = queryInt(q, "after", 0)
	mut size = queryInt(q, "limit", SnapshotPage)
	if after < 0 || size < 1 {
		badRequest(q, mut w, "after and limit are numbers")
		return
	}
	size = min(size, SnapshotPage)
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let o = tree.Snapshot(d.Db, teamOf(q), after, size) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, o)
}

fn node(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let n = tree.Get(d.Db, teamOf(q), idOf(q, "id")) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, n)
}

