// BlockOut answers an upload.
type BlockOut struct {
	@json("hash") Hash str
	@json("size") Size i64
}

fn putBlock(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let hash = q.PathParam("hash")
	let body = q.Body()
	tree.PutBlock(d.Db, d.Store, teamOf(q), hash, body) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, BlockOut{Hash: hash, Size: len(body)})
}

fn getBlock(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let data = tree.GetBlock(d.Db, d.Store, teamOf(q), q.PathParam("hash")) catch err {
		sendFault(q, mut w, err)
		return
	}
	w.Type("application/octet-stream")
	w.Body = append(w.Body, []u8(data)...)
}

fn urls(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	mut in = tree.HashesIn{}
	argo.GetStrict(q.Body(), mut in) catch err {
		badRequest(q, mut w, fault.Message(err))
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let o = tree.URLs(d.Db, d.Store, teamOf(q), in, d.ViaServer, d.PublicURL, URLLife) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, o)
}

fn putPart(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let part = mint.Atoi(q.PathParam("part")) catch _ {
		-1
	}
	let body = q.Body()
	tree.PutPart(d.Db, d.Store, teamOf(q), q.PathParam("hash"), part, body) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, BlockOut{Hash: q.PathParam("hash"), Size: len(body)})
}

fn completeUpload(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	mut in = tree.PartsIn{}
	argo.GetStrict(q.Body(), mut in) catch err {
		badRequest(q, mut w, fault.Message(err))
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let hash = q.PathParam("hash")
	let size = tree.CompleteUpload(d.Db, d.Store, teamOf(q), hash, in.Parts) catch err {
		sendFault(q, mut w, err)
		return
	}
	sendJSON(mut w, BlockOut{Hash: hash, Size: size})
}

// Mount adds every route to r.
fn Mount(r mut anvil.Router) {
	r.Get("/healthz", healthz)
	r.Get("/readyz", readyz)
	r.Get("/v1/nonce", nonce)
	r.Post("/v1/invites/accept", acceptInvite)
	r.Post("/v1/links", startLink)
	r.Post("/v1/links/approve", approveLink)
	r.Post("/v1/links/claim", claimLink)
	r.Get("/v1/me", me)
	r.Delete(`/v1/devices/{id}`, revokeDevice)
	r.Post("/v1/teams", createTeam)
	r.Get(`/v1/teams/{team}/members`, members)
	r.Delete(`/v1/teams/{team}/members/{user}`, removeMember)
	r.Post(`/v1/teams/{team}/invites`, invite)
	r.Get(`/v1/teams/{team}/head`, head)
	r.Get(`/v1/teams/{team}/delta`, delta)
	r.Get(`/v1/teams/{team}/wait`, wait)
	r.Get(`/v1/teams/{team}/snapshot`, snapshot)
	r.Get(`/v1/teams/{team}/nodes/{id}`, node)
	r.Get(`/v1/teams/{team}/nodes/{id}/children`, children)
	r.Get(`/v1/teams/{team}/nodes/{id}/versions`, versions)
	r.Post(`/v1/teams/{team}/nodes/{id}/restore`, restore)
	r.Get(`/v1/teams/{team}/trash`, trash)
	r.Post(`/v1/teams/{team}/rewind`, rewind)
	r.Post(`/v1/teams/{team}/commit`, commit)
	r.Post(`/v1/teams/{team}/blocks/missing`, missing)
	r.Post(`/v1/teams/{team}/blocks/urls`, urls)
	r.Put(`/v1/teams/{team}/blocks/{hash}`, putBlock)
	r.Get(`/v1/teams/{team}/blocks/{hash}`, getBlock)
	r.Put(`/v1/teams/{team}/uploads/{hash}/{part}`, putPart)
	r.Post(`/v1/teams/{team}/uploads/{hash}/complete`, completeUpload)
}
