fn versions(q anvil.Req, w mut anvil.Out) {
	let who = member(q, mut w, false)
	if who == nil {
		return
	}
	let d = current() catch err {
		sendFault(q, mut w, err)
		return
	}
	let vs = tree.Versions(d.Db, teamOf(q), idOf(q, "id")) catch err {
